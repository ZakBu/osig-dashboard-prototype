{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "verbatimModuleSyntax": false,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "@coss/ui/lib/*": ["./src/coss/lib/*"],
      "@coss/ui/components/*": ["./src/coss/components/*"],
      "@coss/ui/hooks/*": ["./src/coss/hooks/*"],
      "@coss/ui/base-ui/*": ["./src/coss/base-ui/*"],
      "@coss/ui/fonts": ["./src/coss/fonts/index.ts"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
