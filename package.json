    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "apexcharts": "3.54.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.555.0",
    "next": "15.1.6",
    "pdfjs-dist": "^6.1.200",
    "react": "19.0.0",
    "react-apexcharts": "1.7.0",
    "react-dom": "19.0.0",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.7.5",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "tailwindcss": "4.1.17",
    "typescript": "5.6.3",
    "vitest": "^4.1.9"
