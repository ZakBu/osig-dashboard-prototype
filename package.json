{
  "name": "azs-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Десктопный дашборд АЗС (Next.js UI). Данные и доклады — из azs-api.",
  "scripts": {
    "predev": "node scripts/copy-pdf-worker.mjs",
    "dev": "next dev -p 3000",
    "prebuild": "node scripts/copy-pdf-worker.mjs",
